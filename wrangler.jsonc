{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "goal-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9cc663f7-8e5a-4dfb-99a4-8964e8bf0aae","database_name": "goal-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "d0c441488d25408284e162b2de5b735c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
